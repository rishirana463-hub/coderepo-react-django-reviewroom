# setup generates both secrets when backend/.env is absent. Keep real .env private.
DJANGO_SECRET_KEY=
JWT_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/reviewroom_db
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public demo-only credentials; override before any deployment.
SEED_PASSWORD=Reviewroom2026!
